  <util category="Car" name="U_card">
    <formula xsi:type="codeGen:AddTerm" type="+">
      <left xsi:type="codeGen:AddTerm" type="+">
        <left xsi:type="codeGen:AddTerm" type="+">
          <left xsi:type="codeGen:AddTerm" type="+">
