                                                    <left xsi:type="codeGen:AddTerm" type="+">
                                                      <left xsi:type="codeGen:AddTerm" type="+">
                                                        <left xsi:type="codeGen:AddTerm" type="+">
                                                          <left xsi:type="codeGen:AddTerm" type="+">
                                                            <left xsi:type="codeGen:AddTerm" type="+">
                                                              <left xsi:type="codeGen:AddTerm" type="+">
                                                                <left xsi:type="codeGen:ConstantLiteral" value="IS_ACTIVITY_TYPE_SHOPPING_DAILY"/>
                                                                <right xsi:type="codeGen:ConstantLiteral" value="IS_ACTIVITY_TYPE_SHOPPING_OTHER"/>
                                                              </left>
                                                              <right xsi:type="codeGen:ConstantLiteral" value="IS_ACTIVITY_TYPE_PRIVATE_BUSINESS"/>
                                                            </left>
                                                            <right xsi:type="codeGen:ConstantLiteral" value="IS_ACTIVITY_TYPE_LEISURE_INDOOR"/>
                                                          </left>
                                                          <right xsi:type="codeGen:ConstantLiteral" value="IS_ACTIVITY_TYPE_LEISURE_OUTDOOR"/>
                                                        </left>
                                                        <right xsi:type="codeGen:ConstantLiteral" value="IS_ACTIVITY_TYPE_LEISURE_OTHER"/>
                                                      </left>
                                                      <right xsi:type="codeGen:ConstantLiteral" value="IS_ACTIVITY_TYPE_PTIVATE_VISIT"/>
                                                    </left>
                                                    <right xsi:type="codeGen:ConstantLiteral" value="IS_ACTIVITY_TYPE_SERVICE"/>
                                                  </left>
                                                  <right xsi:type="codeGen:ConstantLiteral" value="IS_ACTIVITY_TYPE_EDUCATION_PRIMARY"/>
                                                </left>
                                                <right xsi:type="codeGen:ConstantLiteral" value="IS_ACTIVITY_TYPE_EDUCATION_SECONDARY"/>
                                              </left>
                                              <right xsi:type="codeGen:ConstantLiteral" value="IS_ACTIVITY_TYPE_EDUCATION_TERTIARY"/>
                                            </left>
