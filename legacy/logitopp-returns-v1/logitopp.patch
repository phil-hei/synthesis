+// Lokal modernisierte Build-Datei für den SyntheSis-Validierungs-Spike:
+// Original (Gradle 6.3 / Java 12 / jcenter) baut auf aktuellen Toolchains nicht mehr.
+// Änderungen: Gradle-8-Syntax (implementation statt compile), Lombok-Update,
+// signing/Remote-Publishing entfernt, mobitopp-Version gepinnt.
+plugins {
+    id 'java'
+    id 'maven-publish'
+}
+
+group = 'edu.kit.ifv.mobitopp'
+version = '0.0-synthesis-returns-v1'
+
+java {
+    toolchain {
+        languageVersion = JavaLanguageVersion.of(25)
+    }
+}
+
+repositories {
+    mavenLocal()
+    mavenCentral()
+    maven { url = "https://jitpack.io" }
+}
+
+configurations.all {
+    exclude group: 'xerces', module: 'xerces'
+}
+
+dependencies {
+    annotationProcessor 'org.projectlombok:lombok:1.18.46'
+    compileOnly 'org.projectlombok:lombok:1.18.46'
+
+    implementation 'edu.kit.ifv.mobitopp:mobitopp:0.3.580'
+    implementation 'org.jgrapht:jgrapht-core:1.5.1'
+
+    testAnnotationProcessor 'org.projectlombok:lombok:1.18.46'
+    testCompileOnly 'org.projectlombok:lombok:1.18.46'
+    testImplementation 'org.junit.jupiter:junit-jupiter:5.10.2'
+    testImplementation 'org.mockito:mockito-core:5.11.0'
+    testImplementation 'org.assertj:assertj-core:3.25.3'
+}
+
+test {
+    useJUnitPlatform()
+}
+
+publishing {
+    publications {
+        mavenJava(MavenPublication) {
+            from components.java
+            artifactId = 'logitopp'
+        }
+    }
+}
