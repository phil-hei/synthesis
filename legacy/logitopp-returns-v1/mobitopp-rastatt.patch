index 0000000..12131de
--- /dev/null
+++ b/src/main/java/edu/kit/ifv/mobitopp/simulation/ParcelLocationClustering.java
@@ -0,0 +1,25 @@
+package edu.kit.ifv.mobitopp.simulation;
+
+import java.util.List;
+
+import edu.kit.ifv.mobitopp.simulation.parcels.IParcel;
+import edu.kit.ifv.mobitopp.simulation.parcels.clustering.DeliveryClusteringStrategy;
+
+/**
+ * Gruppiert Pickup- und Zustellpakete nach dem tatsächlichen Tourstopp.
+ * AgentDeliveryClustering gruppiert Pickups nach Producer; bei privaten
+ * Pickups ist das für alle Aufträge dasselbe Depot.
+ */
+public class ParcelLocationClustering implements DeliveryClusteringStrategy {
+
+	@Override
+	public boolean canBeGrouped(IParcel first, IParcel second) {
+		return first.getZone().equals(second.getZone())
+				&& first.getLocation().equals(second.getLocation());
+	}
+
+	@Override
+	public ZoneAndLocation getStopLocation(List<IParcel> parcels) {
+		return parcels.get(0).getZoneAndLocation();
+	}
+}
diff --git a/src/main/java/edu/kit/ifv/mobitopp/simulation/ShortTermModuleDelivery.java b/src/main/java/edu/kit/ifv/mobitopp/simulation/ShortTermModuleDelivery.java
new file mode 100644
index 0000000..0c045aa
--- /dev/null
+++ b/src/main/java/edu/kit/ifv/mobitopp/simulation/ShortTermModuleDelivery.java
@@ -0,0 +1,57 @@
+package edu.kit.ifv.mobitopp.simulation;
+
+import java.io.File;
+import java.io.IOException;
+import java.time.Duration;
+import java.time.LocalDateTime;
+
+import edu.kit.ifv.mobitopp.Disclaimer;
+import edu.kit.ifv.mobitopp.data.local.DynamicTypeMapping;
+import edu.kit.ifv.mobitopp.data.local.configuration.TravelTimeMatrixType;
+import edu.kit.ifv.mobitopp.populationsynthesis.DefaultMappings;
+import edu.kit.ifv.mobitopp.util.dataimport.Bbsr17Repository;
+import edu.kit.ifv.mobitopp.visum.StandardNetfileLanguages;
+
+/**
+ * SyntheSis-Validierung: Short-Term-Modul mit logiTopp-Pakets simulation
+ * (DemandSimulatorDelivery statt DemandSimulatorPassenger).
+ */
+public class ShortTermModuleDelivery extends Simulation {
+
+	public ShortTermModuleDelivery(SimulationContext context) {
+		super(context);
+	}
+
+	@Override
+	protected DemandSimulator simulator() {
+		return new SimulatorBuilder(context()).buildDelivery();
+	}
+
+	public static void main(String... args) throws IOException {
+		if (1 > args.length) {
+			System.out.println("Usage: ... <configuration file>");
+			System.exit(-1);
+		}
+		Disclaimer.disclaim();
+
+		File configurationFile = new File(args[0]);
+		LocalDateTime start = LocalDateTime.now();
+		PersonChangerFactory factory = new MixedPersonChangerFactory();
+		SimulationContext context = new ContextBuilder(new Bbsr17Repository())
+				.use(StandardNetfileLanguages::english)
+				.use(typeMapping())
+				.use(factory)
+				.buildFrom(configurationFile);
+		new ShortTermModuleDelivery(context).simulate();
+		System.out.println("logiTopp-Simulation took " + Duration.between(start, LocalDateTime.now()));
+	}
+
+	private static DynamicTypeMapping typeMapping() {
+		DynamicTypeMapping mapping = DefaultMappings.autonomousModes();
+		mapping.add(StandardMode.TAXI, TravelTimeMatrixType.car);
+		// logiTopp-Zustellfahrzeuge nutzen die Pkw-Reisezeitmatrix
+		mapping.add(StandardMode.TRUCK, TravelTimeMatrixType.car);
+		mapping.add(StandardMode.BIKE, TravelTimeMatrixType.bike);
+		return mapping;
+	}
+}
